# Copy this file to .env and adjust values before running locally.

APP_NAME=BlogSphere API
ENVIRONMENT=development
DEBUG=true

# Generate a strong random value for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite for zero-setup local dev; swapped for Postgres automatically in docker-compose
DATABASE_URL=sqlite:///./blogsphere.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50
CACHE_TTL_SECONDS=30
RATE_LIMIT_PER_MINUTE=120

# Insert sample users and posts on first boot. Set to false for an empty database.
SEED_DEMO_DATA=true

# AI topic: leave ANTHROPIC_API_KEY / OPENAI_API_KEY blank to use the
# built-in local fallback summarizer (no external calls, always works).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_REQUEST_TIMEOUT_SECONDS=20
